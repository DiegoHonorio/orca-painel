{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "painel-trabalho",
  "name": "Painel de Trabalho",
  "version": "0.5.0",
  "description": "See what you worked on by day, week and month (Claude Code and Codex time, tokens, estimated cost, commits, pomodoro, to-dos), plus a light system view: CPU, GPU, memory, top programs, open ports, network and battery. Everything stays on your machine. English, Português, Español, 中文.",
  "license": "MIT",
  "author": {
    "name": "Diego Honorio Santos"
  },
  "repository": "https://github.com/DiegoHonorio/orca-painel",
  "homepage": "https://github.com/DiegoHonorio/orca-painel",
  "icon": "media/icon.png",
  "cover": {
    "path": "media/cover.png",
    "alt": "The panel in Orca: weekly summary with active time, focus, cost, commits, time per project and bars per day, next to the session list."
  },
  "screenshots": [
    {
      "path": "media/screenshot-resumo.png",
      "alt": "Weekly summary with KPIs and sparklines, time per project, and a monthly view of estimated cost per day.",
      "caption": "Day, week and month at a glance",
      "theme": "dark"
    },
    {
      "path": "media/screenshot-historico.png",
      "alt": "List of Claude Code and Codex sessions with project, branch, time and cost, next to the list of commits grouped by day.",
      "caption": "Every session and commit",
      "theme": "dark"
    },
    {
      "path": "media/screenshot-foco.png",
      "alt": "Pomodoro running with the to-do list, next to the daily summary showing focus minutes per hour.",
      "caption": "Pomodoro and tasks",
      "theme": "dark"
    },
    {
      "path": "media/screenshot-sistema.png",
      "alt": "System tab: CPU, memory, top 5 programs, AI agents, open dev ports, network and battery",
      "caption": "System view",
      "theme": "dark"
    }
  ],
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "painel",
        "title": "Painel de Trabalho",
        "icon": "bar-chart-3",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "pomodoro.alternar",
        "title": "Pomodoro: start / pause"
      },
      {
        "id": "pomodoro.parar",
        "title": "Pomodoro: stop"
      }
    ],
    "statusBarItems": [
      {
        "id": "pomodoro",
        "text": "Pomodoro",
        "icon": "play",
        "tooltip": "Pomodoro: click to start or pause",
        "command": "pomodoro.alternar"
      }
    ],
    "settings": [
      {
        "key": "idioma",
        "title": "Language / Idioma / Idioma / 语言",
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "en",
          "pt-BR",
          "es",
          "zh-CN"
        ],
        "enumLabels": [
          "Same as Orca",
          "English",
          "Português (Brasil)",
          "Español",
          "中文（简体）"
        ]
      },
      {
        "key": "sistemaIntervalo",
        "title": "System tab: refresh every N seconds (only while the tab is open)",
        "type": "integer",
        "default": 3,
        "minimum": 2,
        "maximum": 10
      },
      {
        "key": "focoMinutos",
        "title": "Pomodoro: focus minutes",
        "type": "integer",
        "default": 25,
        "minimum": 1,
        "maximum": 180
      },
      {
        "key": "pausaMinutos",
        "title": "Pomodoro: short break minutes",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 60
      },
      {
        "key": "pausaLongaMinutos",
        "title": "Pomodoro: long break minutes",
        "type": "integer",
        "default": 15,
        "minimum": 1,
        "maximum": 120
      },
      {
        "key": "ciclosAtePausaLonga",
        "title": "Pomodoro: focus rounds before a long break",
        "type": "integer",
        "default": 4,
        "minimum": 1,
        "maximum": 12
      },
      {
        "key": "pastasClaude",
        "title": "Claude Code data folders (comma-separated)",
        "type": "string",
        "default": "~/.claude"
      },
      {
        "key": "pastasCodex",
        "title": "Codex data folders (comma-separated)",
        "type": "string",
        "default": "~/.codex"
      },
      {
        "key": "pastasRepos",
        "title": "Folders to search for git repositories (comma-separated)",
        "type": "string",
        "default": "~/dev"
      },
      {
        "key": "emailsGit",
        "title": "Your commit author e-mails (empty = git config user.email)",
        "type": "string",
        "default": ""
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
